{
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/statusline.sh\""
  },
  "permissions": {
    "deny": ["Read(**/.env)", "Read(**/.env.*)"],
    "ask": [
      "Bash(python3 -m food.restock pull --commit*)",
      "Bash(python3 -m food.restock push*)",
      "Bash(python3 -m food.restock tick-all*)"
    ],
    "allow": [
      "Bash(python3 -m food.restock pull)",
      "Bash(set -a; . food/.env; set +a*)"
    ]
  }
}
